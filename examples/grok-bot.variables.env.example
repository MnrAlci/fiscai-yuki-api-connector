# Variables for the Grok Bot plugin form (names only; enter the real value in Grok Bot's own settings,
# never in a file that is shared or committed). Example values are placeholders.
YUKI_ACCESS_KEY=YOUR_YUKI_ACCESS_KEY
# 'domein' = key of one domain/administration (business owner), 'portaal' = portal key (accountant)
YUKI_ACCESS_LEVEL=domein
# Leave unset: writing to Yuki stays disabled.
# YUKI_WRITE_ENABLED=
