{
  "mcpServers": {
    "fiscai-yuki-api-connector": {
      "type": "stdio",
      "command": "/ABSOLUTE/PATH/TO/fiscai-yuki-api-connector/.venv/bin/python",
      "args": [
        "/ABSOLUTE/PATH/TO/fiscai-yuki-api-connector/server/run_server.py"
      ],
      "env": {
        "YUKI_ACCESS_KEY": "${YUKI_ACCESS_KEY}",
        "YUKI_ACCESS_LEVEL": "domein"
      }
    }
  }
}
